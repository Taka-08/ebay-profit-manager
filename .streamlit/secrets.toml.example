# This example is safe to commit. Never commit the real secrets.toml file.

[auth]
REQUIRE_AUTH = true
APP_USERNAME = "admin"
# Replace this value, or use APP_PASSWORD_HASH generated by the helper script.
APP_PASSWORD = "replace-with-a-long-random-password"
# APP_PASSWORD_HASH = "pbkdf2_sha256$600000$...$..."

[database]
TURSO_DATABASE_URL = "libsql://replace-with-your-database.turso.io"
TURSO_AUTH_TOKEN = "replace-with-your-database-token"
